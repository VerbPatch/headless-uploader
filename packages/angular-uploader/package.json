{
  "name": "@verbpatch/angular-uploader",
  "version": "0.0.1-beta.2",
  "description": "A headless uploader library for Angular applications with full chunked upload and pause-and-resume support.",
  "author": "Rameez Raja <rameezrajapathan@live.com>",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/verbpatch/headless-uploader",
  "repository": {
    "type": "git",
    "url": "https://github.com/verbpatch/headless-uploader.git",
    "directory": "packages/angular-uploader"
  },
  "bugs": {
    "url": "https://github.com/verbpatch/headless-uploader/issues"
  },
  "type": "module",
  "module": "dist/fesm2022/verbpatch-angular-uploader.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "esm": "./dist/esm2022/verbpatch-angular-uploader.mjs",
      "esm2022": "./dist/esm2022/verbpatch-angular-uploader.mjs",
      "default": "./dist/fesm2022/verbpatch-angular-uploader.mjs"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "keywords": [
    "verbpatch",
    "angular",
    "uploader",
    "headless",
    "resumable-upload",
    "chunked-upload",
    "http",
    "tus",
    "websocket",
    "webtransport",
    "typescript"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "ng-packagr -p ng-package.json"
  },
  "dependencies": {
    "@verbpatch/headless-uploader": "workspace:*",
    "tslib": "^2.8.1"
  },
  "peerDependencies": {
    "@angular/common": "^20.3.0",
    "@angular/core": "^20.3.0"
  },
  "devDependencies": {
    "@angular/core": "^20.3.12",
    "ng-packagr": "^17.3.0",
    "typescript": "^5.9.3"
  },
  "sideEffects": false
}

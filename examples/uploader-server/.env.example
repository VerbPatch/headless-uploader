# ==============================================================================
# Headless Uploader Server - Configuration Guide
# ==============================================================================

# --- General Server Configuration ---
# The port where your Node.js express server will listen.
APP_PORT=3000
# A simple shared secret to authorize requests. 
# Used in headers like: { "Authorization": "Bearer verbpatch-secret-token" }
AUTH_TOKEN=verbpatch-secret-token

# --- AWS S3 Configuration ---
# 1. AWS_REGION: The region where your bucket was created (e.g., us-east-1, eu-west-1).
# 2. AWS_ACCESS_KEY_ID: Found in IAM -> Users -> Security credentials -> Access keys.
# 3. AWS_SECRET_ACCESS_KEY: Generated alongside the Access Key ID.
# 4. AWS_S3_BUCKET: The exact name of your S3 bucket.
#
# IMPORTANT: Ensure your IAM user has 's3:PutObject' permissions for this bucket.
# CORS: You MUST enable PUT method in your S3 bucket CORS configuration.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET=your_s3_bucket_name

# --- Azure Blob Storage Configuration ---
# 1. AZURE_STORAGE_ACCOUNT_NAME: The unique name of your Azure Storage Account.
# 2. AZURE_STORAGE_ACCOUNT_KEY: Found in Storage Account -> Access keys -> key1 or key2.
# 3. AZURE_STORAGE_CONTAINER: The name of the container (folder) inside your storage account.
#
# HOW TO GET: Azure Portal -> Search 'Storage accounts' -> Select yours -> 
#             Look for 'Access keys' under 'Security + networking'.
# CORS: Enable 'PUT' method in the 'Resource sharing (CORS)' blade of the Storage Account.
AZURE_STORAGE_ACCOUNT_NAME=your_azure_account_name
AZURE_STORAGE_ACCOUNT_KEY=your_azure_access_key
AZURE_STORAGE_CONTAINER=your_container_name

# --- Google Cloud Storage (GCS) Configuration ---
# 1. GCS_PROJECT_ID: The unique ID of your Google Cloud Project.
# 2. GCS_BUCKET: The name of your GCS bucket.
# 3. GCS_KEY_FILE: The ENTIRE content of your Service Account JSON key file.
#    Wrap the JSON in single quotes to handle the special characters.
#
# HOW TO GET: 
# a. Google Cloud Console -> IAM & Admin -> Service Accounts.
# b. Create a Service Account (give it 'Storage Object Creator' role).
# c. Click the account -> Keys -> Add Key -> Create new key -> JSON.
# d. Copy the content of the downloaded .json file and paste it below.
GCS_PROJECT_ID=your_gcs_project_id
GCS_BUCKET=your_gcs_bucket_name
GCS_KEY_FILE='{"type": "service_account", "project_id": "...", "private_key": "...", "client_email": "...", ...}'

APP_HOST=localhost
APP_PORT=3000
AUTH_TOKEN=your-secret-token

# --- AWS S3 Setup ---
# 1. Login to AWS Console -> IAM
# 2. Create a user with 'AmazonS3FullAccess' (or scoped permissions)
# 3. Create 'Access Key' for that user to get ID and Secret
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# --- Azure Blob Storage Setup ---
# 1. Login to Azure Portal -> Storage Accounts
# 2. Create a Storage Account
# 3. Go to 'Security + networking' -> 'Access keys' to find the Account Name and Key
# 4. Create a 'Container' in the 'Containers' tab
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER=

# --- Google Cloud Storage (GCS) Setup ---
# 1. Login to Google Cloud Console -> Storage
# 2. Create a Bucket
# 3. Go to 'IAM & Admin' -> 'Service Accounts'
# 4. Create a Service Account, give it 'Storage Admin' role
# 5. Create a JSON Key for that account and paste the ENTIRE JSON string here (single line)
GCS_PROJECT_ID=
GCS_BUCKET=
GCS_KEY_FILE=
<configuration>
  <system.webServer>
    <!-- Enable WebSockets -->
    <webSocket enabled="true" />
    
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    
    <iisnode 
      node_env="production" 
      loggingEnabled="true" 
      debuggingEnabled="false" 
      nodeProcessCommandLine="C:\nvm4w\nodejs\node.exe --no-deprecation" 
      webSocketConcurrentRequestLimit="200"
    />
    
    <rewrite>
      <rules>
        <clear />
        <!-- Force HTTPS but EXCLUDE websocket to prevent handshake redirect loops -->
        <rule name="Redirect to https" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{HTTPS}" pattern="off" ignoreCase="true" />
            <add input="{REQUEST_URI}" pattern="^/ws-upload" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}{REQUEST_URI}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        
        <!-- Ensure WebSocket headers are passed correctly -->
        <rule name="websocket" stopProcessing="true">
          <match url="ws-upload" />
          <action type="Rewrite" url="server.js" />
        </rule>

        <rule name="nodejs">
          <match url="(.*)" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_URI}" pattern="^/tus" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
        
        <rule name="tus">
          <match url="^tus(/.*)?$" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    
    <security>
      <requestFiltering allowDoubleEscaping="true">
        <hiddenSegments>
          <add segment="node_modules" />
          <add segment="iisnode" />
        </hiddenSegments>
        <requestLimits maxAllowedContentLength="2147483648" />
        <verbs>
          <add verb="PATCH" allowed="true" />
          <add verb="DELETE" allowed="true" />
          <add verb="HEAD" allowed="true" />
          <add verb="OPTIONS" allowed="true" />
          <add verb="PUT" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
    
    <httpErrors errorMode="Detailed" existingResponse="PassThrough" />
  </system.webServer>
</configuration>
